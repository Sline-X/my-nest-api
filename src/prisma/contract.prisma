// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum AdminRole {
  MANAGER
  ROOT
}

enum TerminalStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  UNDER_CONSIDERATION
  APPROVED
  REJECTED
}

model Admin {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role AdminRole
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ShopOwner {
  id Int @id @default(autoicrement())
  name String
  phoneNumber String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Shop {
  id Int @id @default(autoincrement())
  name String
  inn String @db.VarChar(10)
  kpp String @db.VarChar(9)
  ogrn String @db.VarChar(13)
  registeredOfficeAddress String
  actualAddress String
  login String
  password String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Terminal {
  id Int @id @default(autoincrement())
  macAddress String  @unique @db.VarChar(17)
  status TerminalStatus
  link String
}

model Request {
  id Int @id @default(autoincrement())
  createRequest TimestamptzString @default(now())
  macAddress String  @unique @db.VarChar(17)
  shop Shop
  status RequestStatus
  comment String
}